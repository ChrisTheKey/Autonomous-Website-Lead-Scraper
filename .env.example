# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lead_discovery

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Google Maps Platform ─────────────────────────────────────────────────────
# Requires: Places API (New) enabled in Google Cloud Console
GOOGLE_MAPS_API_KEY=AIza...

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_RESULTS_PER_SEARCH=100
MAX_PAGES_PER_DOMAIN=10
GOOGLE_DATA_TTL_DAYS=30

# ─── Compliance ───────────────────────────────────────────────────────────────
# Set to true to require manual verification before any export
EXPORT_REQUIRES_VERIFICATION=true
