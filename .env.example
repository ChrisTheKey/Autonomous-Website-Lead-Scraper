# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lead_discovery

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Google Maps Platform ─────────────────────────────────────────────────────
# Requires: Places API (New) enabled in Google Cloud Console
GOOGLE_MAPS_API_KEY=AIza...

# ─── ScrapeGraphAI (LLM-driven scraping, backend/) ────────────────────────────
OPENAI_API_KEY=sk-...
# Provider prefix optional — "openai/" is assumed when none is given
SCRAPEGRAPH_MODEL=openai/gpt-4o-mini
SCRAPEGRAPH_HEADLESS=true
SCRAPEGRAPH_VERBOSE=false
SCRAPEGRAPH_TIMEOUT=120
SCRAPEGRAPH_MAX_RESULTS=3
# Never set to false for third-party sites — robots.txt is respected as policy
SCRAPEGRAPH_RESPECT_ROBOTS=true

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
DEBUG=false

# ─── Limits ───────────────────────────────────────────────────────────────────
MAX_RESULTS_PER_SEARCH=100
MAX_PAGES_PER_DOMAIN=10
GOOGLE_DATA_TTL_DAYS=30

# ─── Compliance ───────────────────────────────────────────────────────────────
# Set to true to require manual verification before any export
EXPORT_REQUIRES_VERIFICATION=true
