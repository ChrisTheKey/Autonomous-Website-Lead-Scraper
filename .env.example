# ─────────────────────────────────────────────
#  Autonomous Website Lead Scraper – Environment
# ─────────────────────────────────────────────

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/lead_scraper
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-...

# Google Maps
GOOGLE_MAPS_API_KEY=AIza...

# HubSpot
HUBSPOT_API_KEY=...
HUBSPOT_ACCESS_TOKEN=...

# Pipedrive
PIPEDRIVE_API_KEY=...
PIPEDRIVE_COMPANY_DOMAIN=yourcompany

# Salesforce
SALESFORCE_USERNAME=...
SALESFORCE_PASSWORD=...
SALESFORCE_SECURITY_TOKEN=...
SALESFORCE_DOMAIN=login  # or test

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Celery / Airflow
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql://postgres:password@localhost:5432/airflow

# App
SECRET_KEY=changeme
DEBUG=true
LOG_LEVEL=INFO
